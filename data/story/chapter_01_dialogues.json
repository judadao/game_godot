      "lines": [
        {"speaker": "priest", "emotion": "chat", "text": "喂。"},
        {"speaker": "protagonist", "emotion": "surprised", "text": "痛。"},
        {"speaker": "priest", "emotion": "happy", "text": "原來醒著。"},
        {"speaker": "protagonist", "emotion": "chat", "text": "我一直醒著。"},
        {"speaker": "priest", "emotion": "chat", "text": "那你杵在這裡做什麼？"},
        {"speaker": "priest", "emotion": "chat", "text": "平常這個時候，你不是都在打鐵嗎？"},
        {"speaker": "protagonist", "emotion": "chat", "text": "我本來要去。"},
        {"speaker": "priest", "emotion": "chat", "text": "然後呢？"},
        {"speaker": "protagonist", "emotion": "sad", "text": "聽見有人在叫我。"},
        {"speaker": "priest", "emotion": "surprised", "text": "誰？"},
        {"speaker": "protagonist", "emotion": "sad", "text": "不知道。回頭以後就忘了。"},
        {"speaker": "protagonist", "emotion": "happy", "text": "算了。真有急事，總會再叫一次。"},
        {"speaker": "priest", "emotion": "chat", "text": "上次你也這麼說，後來繞著城牆找了一整天。"},
        {"speaker": "protagonist", "emotion": "happy", "text": "這次我只找半天。"},
        {"speaker": "priest", "emotion": "chat", "text": "先回去開爐。守衛的劍天還沒亮就送到了。"},
        {"speaker": "protagonist", "emotion": "chat", "text": "妳不去教堂？"},
        {"speaker": "priest", "emotion": "happy", "text": "去。但我要先看著你走到門口。"},
        {"speaker": "protagonist", "emotion": "chat", "text": "我又不會迷路。"},
        {"speaker": "protagonist", "emotion": "happy", "text": "我先去打水。"},
        {"speaker": "priest", "emotion": "chat", "text": "水井在另一邊。"},
        {"speaker": "protagonist", "emotion": "sad", "text": "……我先開爐。"}
      ]
    }
  }
