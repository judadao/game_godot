[resource]
TownServiceWindow/base_type = &"PanelContainer"
TownServiceWindow/styles/panel = SubResource("WindowStyle")
TownServicePortrait/base_type = &"PanelContainer"
TownServicePortrait/styles/panel = SubResource("PortraitStyle")
TownServiceTitle/base_type = &"Label"
TownServiceTitle/colors/font_color = Color(1, 0.86, 0.48, 1)
TownServiceTitle/font_sizes/font_size = 28
TownServiceCloseButton/base_type = &"Button"
