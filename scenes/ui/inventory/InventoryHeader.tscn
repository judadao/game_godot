[gd_scene load_steps=3 format=3]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_header"]
bg_color = Color(0.18, 0.125, 0.075, 0.9)
border_width_bottom = 1
border_color = Color(0.58, 0.43, 0.24, 0.85)

[sub_resource type="LabelSettings" id="LabelSettings_title"]
font_size = 28
font_color = Color(0.95, 0.82, 0.55, 1)

[node name="HeaderPanel" type="PanelContainer"]
theme_override_styles/panel = SubResource("StyleBoxFlat_header")

[node name="HeaderMargin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 8
theme_override_constants/margin_bottom = 8

[node name="HeaderRow" type="HBoxContainer" parent="HeaderMargin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="HeaderMargin/HeaderRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "Inventory"
label_settings = SubResource("LabelSettings_title")

[node name="CurrencyDisplay" type="Label" parent="HeaderMargin/HeaderRow"]
layout_mode = 2
theme_override_colors/font_color = Color(0.96, 0.78, 0.36, 1)
theme_override_font_sizes/font_size = 18
text = "Gold: 1,245"
horizontal_alignment = 2
vertical_alignment = 1

[node name="CloseButton" type="Button" parent="HeaderMargin/HeaderRow"]
custom_minimum_size = Vector2(42, 36)
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "X"
